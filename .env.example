PORT=3000
HOTELS_API_URL=http://api/v1
HOTELS_API_HOST=api.hotels24.stage
HOTEL_PUBLIC_BASE_URL=https://hotels24.ua
HOTELS_API_KEY=
HOTELS_API_TIMEOUT_MS=8000
HOTELS_API_RETRIES=2
MCP_AUTH_TOKEN=replace-with-a-long-random-token
MCP_ALLOWED_ORIGINS=
MCP_MAX_RESULTS=20
MCP_RATE_LIMIT_WINDOW_MS=60000
MCP_RATE_LIMIT_MAX_REQUESTS=120

# BigQuery автоматично працює з secrets/bigquery.json або /etc/hotels24-chat/bigquery.json.
# Несекретні значення вже задані у src/logging/settings.ts.
# Необов'язкові перевизначення:
# CHAT_LOG_ENABLED=false
# BIGQUERY_PROJECT_ID=map-hotels
# BIGQUERY_DATASET_ID=hotels24_chat
# BIGQUERY_TABLE_ID=events
# CHAT_LOG_ENVIRONMENT=local
# CHAT_LOG_QUEUE_DIR=/var/lib/hotels24-chat/queue
# GOOGLE_APPLICATION_CREDENTIALS=/etc/hotels24-chat/bigquery.json
